within ;
record PQ_CapabilityTable
  "Таблица точек P-Q диаграммы произвольного размера"
  parameter Real Snom = 588 "Номинальная полная мощность, МВА";

  // Массивы точек для ВЕРХНЕЙ границы Q_max (нагрев ротора)
  // Размерность [:] определится автоматически при вводе данных!
  parameter Real P_max[:] = {0, 100, 250, 400, 500} "Сетка P для Qmax, МВт";
  parameter Real Qmax[:]  = {320, 320, 315, 312, 310} "Предельные значения Qmax, МВар";

  // Массивы точек для НИЖНЕЙ границы Q_min (недовозбуждение)
  parameter Real P_min[:] = {0, 200, 500} "Сетка P для Qmin, МВт";
  parameter Real Qmin[:]  = {-200, -170, -100} "Предельные значения Qmin, МВар";
end PQ_CapabilityTable;
